// 도깨비 지갑 공통 빌드 설정
// Supabase 값은 환경별 파일에서 지정한다. service_role 키는 절대 넣지 않는다 (SECURITY_POLICY.md §1).
// URL의 "//"는 xcconfig 주석으로 해석되므로 https:/$()/ 형태로 쓴다.

PRODUCT_BUNDLE_IDENTIFIER_BASE = app.dokkaebiwallet.ios
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SUPABASE_URL =
SUPABASE_ANON_KEY =

// 로컬 개발자별 값(개인 팀 ID, 로컬 Supabase 키 등)은 git에 올리지 않는 Local.xcconfig에 둔다.
#include? "Local.xcconfig"
